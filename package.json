{
  "name": "dashboard-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": ".venv/bin/uvicorn main:app --reload --port 8000",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && (pytest -q || .venv/bin/pytest -q)",
    "test:py": "pytest -q",
    "test:all": "vitest run && pytest -q",
    "lint": "tsc --noEmit"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "jsdom": "^25.0.0"
  }
}